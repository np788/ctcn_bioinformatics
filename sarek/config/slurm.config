/*
 * Sanitized SLURM configuration.
 *
 * The original workflow ran nf-core/sarek through Nextflow on a SLURM HPC
 * environment. Queue/account/constraint details are intentionally omitted.
 */

process {
    executor = 'slurm'
}

/*
 * Add site-specific scheduler options only in your private/local config, e.g.
 *
 * process.queue = 'your_partition'
 * process.clusterOptions = '--constraint=your_constraint'
 */
